options:
  parameters:
    alias: ''
    author: ''
    catch_exceptions: 'True'
    comment: v1 + controlo de threshold, min_plateau e ganho; tags do sync_short.
    copyright: ''
    description: ''
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: master_v2
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: Master v2 - + threshold/ganho dinamicos e diagnostico Sync Short
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: '20000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 380
    - 1060
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    value: 2.437e9
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 1060
    rotation: 0
    state: enabled
- name: bw
  id: variable
  parameters:
    value: 20e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1020
    - 1060
    rotation: 0
    state: enabled
- name: nwin
  id: variable_qtgui_range
  parameters:
    label: N_win (aplicar = reiniciar)
    rangeType: int
    value: '48'
    start: '16'
    stop: '128'
    step: '8'
    widget: counter_slider
    orient: QtCore.Qt.Horizontal
    min_len: '200'
    gui_hint: 0,0,1,1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1340
    - 1060
    rotation: 0
    state: enabled
- name: nwin_note
  id: note
  parameters:
    note: '"Janela de autocorrelacao (eq. 1) e da potencia (eq. 2, N_win+16)"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 380
    - 1885
    rotation: 0
    state: enabled
- name: threshold
  id: variable_qtgui_range
  parameters:
    label: Threshold c[n]
    rangeType: float
    value: '0.56'
    start: '0.2'
    stop: '0.95'
    step: '0.01'
    widget: counter_slider
    orient: QtCore.Qt.Horizontal
    min_len: '200'
    gui_hint: 0,1,1,1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1340
    - 1315
    rotation: 0
    state: enabled
- name: threshold_note
  id: note
  parameters:
    note: '"c_max = N_win/(N_win+16) = 0.75 para N_win=48: acima disso nunca deteta"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 780
    - 1885
    rotation: 0
    state: enabled
- name: min_plateau
  id: variable_qtgui_range
  parameters:
