    rangeType: int
    value: '2'
    start: '1'
    stop: '8'
    step: '1'
    widget: counter_slider
    orient: QtCore.Qt.Horizontal
    min_len: '200'
    gui_hint: 0,2,1,1
  states:
    bus_sink: false
    bus_source: false
