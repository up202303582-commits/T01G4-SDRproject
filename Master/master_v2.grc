  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 780
    - 2090
    rotation: 0
    state: enabled
- name: encoding
  id: variable_qtgui_chooser
  parameters:
    label: MCS do transmissor
    type: int
    num_opts: '0'
    options: '[0, 1, 2, 3, 4, 5, 6, 7]'
    labels: '["BPSK 1/2", "BPSK 3/4", "QPSK 1/2", "QPSK 3/4", "16QAM 1/2", "16QAM 3/4", "64QAM 2/3", "64QAM 3/4"]'
    value: '0'
    option0: '0'
    label0: '""'
    option1: '1'
    label1: '""'
    option2: '2'
    label2: '""'
    option3: '3'
    label3: '""'
    option4: '4'
    label4: '""'
    widget: combo_box
    orient: Qt.QHBoxLayout
    gui_hint: 1,3,1,1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1340
    - 1570
    rotation: 0
    state: enabled
- name: msg_strobe
  id: blocks_message_strobe
  parameters:
    msg: pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(int(payload_len), [0x41]*int(payload_len)))
    period: interval
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 380
    - 40
    rotation: 0
    state: enabled
- name: msg_strobe_note
  id: note
  parameters:
    note: '"Payload de payload_len bytes a cada interval ms"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 380
    - 2090
    rotation: 0
    state: enabled
